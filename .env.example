# Reference only: Django does not automatically load this file.
# For local development no environment variables are needed.
# Set these in your host's environment before using production settings.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-private-random-key-at-least-50-characters-long
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_SITE_URL=https://your-domain.example
DJANGO_TRUST_PROXY=false
